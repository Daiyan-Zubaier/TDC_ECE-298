# Project-local configuration; tools/run supplies PDK_ROOT in the container.
set tdc_root [file dirname [file dirname [file normalize [info script]]]]
if {![info exists env(PDK_ROOT)]} {
    set env(PDK_ROOT) [file join $env(HOME) .local share tdc-tools pdk]
}
set PDK_ROOT $env(PDK_ROOT)
set PDK gf180mcuD
set XSCHEM_LIBRARY_PATH [join [list [file join $tdc_root schem] \
    $XSCHEM_SHAREDIR/xschem_library/devices \
    $XSCHEM_SHAREDIR/xschem_library \
    $PDK_ROOT/$PDK/libs.tech/xschem] :]
set 180MCU_MODELS $PDK_ROOT/$PDK/libs.tech/ngspice
set XSCHEM_START_WINDOW [file join $tdc_root schem tdc.sch]
set netlist_type spice
set local_netlist_dir 0
set netlist_dir [file join $tdc_root build sim]
file mkdir $netlist_dir
set f [open [file join $netlist_dir pdk_models.spice] w]
puts $f ".include \"$PDK_ROOT/$PDK/libs.tech/ngspice/design.ngspice\""
puts $f ".lib \"$PDK_ROOT/$PDK/libs.tech/ngspice/sm141064.ngspice\" typical"
puts $f ".include \"$PDK_ROOT/$PDK/libs.ref/gf180mcu_fd_sc_mcu7t5v0/spice/gf180mcu_fd_sc_mcu7t5v0.spice\""
close $f
set f [open [file join $netlist_dir digital_models.spice] w]
foreach name {counter therm_encoder fine_encoder} {
    puts $f ".include \"$tdc_root/synth/$name.spice\""
}
close $f

set f [open [file join $netlist_dir system_models.spice] w]
foreach name {tdc_frontend tdc_vernier tdc_vcd tt_um_daiyan_tdc} {
    puts $f ".include \"$tdc_root/synth/$name.spice\""
}
close $f
